{
	# Every number here can be edited without rebuilding the mod.
	# Comments are allowed - Starsector's JSON reader strips them.

	# --- What a spin costs, in tokens ---
	"spinCost": 5,
	"bigPullCost": 20,

	# --- Turning surplus hulls into tokens ---
	# tokens = round(fleet points * shipTokensPerFleetPoint), reduced by each d-mod,
	# never less than 1 for a ship the machine will accept at all.
	"shipTokensPerFleetPoint": 0.6,
	"shipTokenPenaltyPerDMod": 0.1,

	# --- Turning blueprint chips you already know into tokens ---
	"tokensPerCreditOfDuplicate": 0.0005,

	# --- Odds for one normal spin, as weights. They do not have to add up to 100. ---
	"oddsTier3": 3,
	"oddsTier2": 7,
	"oddsTier1": 12,
	"oddsTier0": 15,
	"oddsNearMiss": 28,
	"oddsNothing": 35,

	# --- Odds for the Big Pull. Always pays a blueprint. ---
	"bigPullTier3": 20,
	"bigPullTier2": 35,
	"bigPullTier1": 30,
	"bigPullTier0": 15,

	# --- Mercy rules ---
	# After this many spins with no blueprint at all, the next spin is guaranteed to pay one.
	"pityAnySpins": 6,
	# After this many spins with no top-quality blueprint, the next payout is top quality.
	"pityTopSpins": 25,

	# --- Double or nothing ---
	"doubleOrNothingWinChance": 0.45,

	# --- Consolation credits on a near miss, as a share of the spin's token cost
	#     valued at this many credits per token. ---
	"creditsPerToken": 4000,
	"nearMissRefund": 0.5
}
